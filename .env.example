# IronGate Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# REQUIRED SECRETS (Generate secure values for production)
# =============================================================================

# Zero-trust gateway verification secret (shared between IronGate and downstream services)
# Generate with: openssl rand -base64 32
IRONGATE_DOWNSTREAM_SHARED_SECRET=

# Keycloak admin password for bootstrap
# Generate with: openssl rand -base64 16
KEYCLOAK_ADMIN_PASSWORD=

# Grafana admin password
# Generate with: openssl rand -base64 16
GRAFANA_ADMIN_PASSWORD=

# Keycloak client secret for IronGate gateway
# Generate with: openssl rand -base64 32
IRONGATE_CLIENT_SECRET=

# Test user password (for development only)
# Generate with: openssl rand -base64 16
IRONGATE_TEST_PASSWORD=

# Admin API key for /admin/* endpoints
# Generate with: openssl rand -base64 32
IRONGATE_ADMIN_API_KEY=

# =============================================================================
# OPTIONAL CONFIGURATION (Defaults shown)
# =============================================================================

# Keycloak server URL
KEYCLOAK_URL=http://localhost:8080

# Keycloak admin username
KEYCLOAK_ADMIN_USER=admin

# IronGate Keycloak realm name
IRONGATE_REALM=irongate

# IronGate Keycloak client ID
IRONGATE_CLIENT_ID=irongate-gateway

# IronGate test user username
IRONGATE_TEST_USER=irongate-user

# Test application redirect URI (for OAuth flows)
IRONGATE_REDIRECT_URI=http://localhost:5023/*

# Allowed web origins for Keycloak client (comma-separated)
IRONGATE_WEB_ORIGINS=http://localhost:5023

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# Redis connection string (for rate limiting and fallback cache)
REDIS_CONNECTION_STRING=localhost:6379

# OpenTelemetry collector endpoint
OTEL_ENDPOINT=http://localhost:4317

# =============================================================================
# PRODUCTION OVERRIDES (Uncomment and configure for production)
# =============================================================================

# ASPNETCORE_ENVIRONMENT=Production
# REDIS_CONNECTION_STRING=rediss://:password@redis-host:6380  # TLS-enabled Redis
# OTEL_ENDPOINT=https://otel-collector:4317
# KEYCLOAK_URL=https://keycloak.example.com
# IRONGATE_REDIRECT_URI=https://app.example.com/*
# IRONGATE_WEB_ORIGINS=https://app.example.com,https://admin.example.com
# ASPNETCORE_URLS=http://+:8080;https://+:8081