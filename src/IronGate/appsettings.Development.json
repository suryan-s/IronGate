{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/master",
    "Audience": "account",
    "RequireHttpsMetadata": false
  },
  "ServiceName": "IronGate",
  "Environment": "Development",
  "Otel": {
    "Endpoint": "http://localhost:4317",
    "Enabled": true
  },
  "ReverseProxy": {
    "Routes": {
      "public-api": {
        "ClusterId": "downstream-echo",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/public/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/public" }
        ]
      },
      "protected-api": {
        "ClusterId": "downstream-echo",
        "AuthorizationPolicy": "jwt-required",
        "Match": {
          "Path": "/api/protected/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/protected" }
        ]
      }
    },
    "Clusters": {
      "downstream-echo": {
        "Destinations": {
          "node-1": {
            "Address": "https://httpbin.org/"
          }
        }
      }
    }
  }
}