{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "IdentityProvider": {
    "Default": "keycloak"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/master",
    "Audience": "irongate-test",
    "RequireHttpsMetadata": false
  },
  "ServiceName": "IronGate",
  "Environment": "Development",
  "Otel": {
    "Endpoint": "http://localhost:4317",
    "Enabled": true
  },
  "RateLimiting": {
    "Public": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Protected": {
      "TokenLimit": 20,
      "TokensPerPeriod": 5,
      "ReplenishmentPeriodSeconds": 10
    },
    "Redis": {
      "Enabled": true,
      "ConnectionString": "localhost:6379",
      "KeyPrefix": "irongate:ratelimit:",
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  "Resilience": {
    "Enabled": true,
    "Hedging": {
      "Enabled": true,
      "MaxHedgedAttempts": 2,
      "DelayMs": 150
    },
    "CircuitBreaker": {
      "Enabled": true,
      "FailureRatio": 0.5,
      "MinimumThroughput": 5,
      "SamplingDurationSeconds": 10,
      "BreakDurationSeconds": 15
    },
    "TotalRequestTimeoutSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "public-api": {
        "ClusterId": "downstream-echo",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/public/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/public" }
        ]
      },
      "protected-api": {
        "ClusterId": "downstream-echo",
        "AuthorizationPolicy": "jwt-required",
        "Match": {
          "Path": "/api/protected/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/protected" }
        ]
      }
    },
    "Clusters": {
      "downstream-echo": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "node-1": {
            "Address": "http://localhost:8081/"
          }
        }
      }
    }
  },
  "FallbackCache": {
    "Enabled": true,
    "TtlSeconds": 300,
    "StaticFallbacks": {
      "/api/public/echo": "{\"status\":\"degraded\",\"message\":\"Served from IronGate static fallback config\"}"
    }
  }
}